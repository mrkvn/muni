{
  "name": "muni-workspace",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter desktop tauri dev",
    "build": "pnpm --filter desktop tauri build",
    "lint": "pnpm --filter desktop lint",
    "test": "pnpm --filter desktop test",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "fmt:rust": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --all",
    "lint:rust": "cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings"
  }
}
