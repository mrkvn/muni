{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability granted to the main app window and onboarding",
  "windows": ["main", "onboarding"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "log:default",
    "store:default",
    "global-shortcut:default",
    "updater:default"
  ]
}
